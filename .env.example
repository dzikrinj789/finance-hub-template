# Copy to .env.local and fill in from your own Supabase project.
# Supabase → Project Settings → API.
# Use the project URL and the anon / publishable key. Never put the service_role key here.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Dev only. Set to 1 to skip login and render empty local data (never in production).
# NEXT_PUBLIC_UI_PREVIEW=1
